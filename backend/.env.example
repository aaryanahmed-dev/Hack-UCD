CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/hackathondb?charset=utf8mb4
# Supabase project URL (Project Settings -> API). Used to verify login tokens.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for older Supabase projects that still sign tokens with the legacy JWT secret
SUPABASE_JWT_SECRET=
# AI quiz generation + grading (https://openrouter.ai/keys). Without it, sessions can't generate a quiz
# and are cancelled with stakes refunded.
OPENROUTER_API_KEY=
# Optional model overrides (default: google/gemma-4-31b-it:free)
# QUIZ_MODEL=
# GRADING_MODEL=

# Public URL of this API (the ngrok domain) — used for the Google OAuth callback
PUBLIC_BASE_URL=https://unthumped-minda-unilluminant.ngrok-free.dev
# Google Calendar sync: Google Cloud console -> APIs & Services -> enable "Google Calendar API";
# Credentials -> OAuth client ID (Web application) with redirect URI
#   <PUBLIC_BASE_URL>/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Stripe sandbox (Dashboard → Developers → API keys, test mode). Coins: 1 coin = €0.01.
STRIPE_SECRET_KEY=sk_test_...
# Optional webhook (Dashboard → Webhooks → endpoint <PUBLIC_BASE_URL>/api/webhooks/stripe,
# events checkout.session.completed / async_payment_succeeded / expired). The app also confirms on return.
STRIPE_WEBHOOK_SECRET=whsec_...
# Persona ID verification sandbox (app.withpersona.com): API key, inquiry template, sandbox environment
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=itmpl_...
PERSONA_ENVIRONMENT_ID=env_...
